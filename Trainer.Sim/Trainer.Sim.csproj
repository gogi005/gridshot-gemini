<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure game logic + math. MUST NOT reference Godot: this assembly is unit-
    testable headlessly and keeps the rules engine portable (replays, bots,
    server-side validation).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Trainer.Sim</RootNamespace>
    <AssemblyName>Trainer.Sim</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
